    {
      "parameters": {
        "jsCode": "let body = {};\ntry { body = $('Webhook').first().json.body || {}; }\ncatch (e) { body = $('Sample Report').first().json.body || {}; }\nconst out = String($input.first().json.output || '');\nconst m = out.match(/SEVERITY:\\s*\\**\\s*(LOW|MEDIUM|HIGH)/i);\nconst severity = m ? m[1].toUpperCase() : 'MEDIUM';\nreturn [{ json: {\n  severity,\n  analysis: out,\n  aircraft_id: body.aircraft_id || '',\n  component: body.component || '',\n  report_date: body.report_date || '',\n  observation: body.observation || '',\n  technician: body.technician || '',\n  location: body.location || ''\n}}];"
      },
