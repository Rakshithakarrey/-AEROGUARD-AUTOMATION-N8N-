    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst clean = s => String(s || '').replace(/[*#`]/g, '').replace(/[^ -~]/g, ' ')\n  .replace(/\\\\/g, '\\\\\\\\').replace(/\\(/g, '\\\\(').replace(/\\)/g, '\\\\)');\n\nconst raw = [\n  'AEROGUARD AI - MAINTENANCE SUPPORT REPORT', '',\n  'Status: ' + d.status,\n  'Message: ' + d.message,\n  'Severity: ' + d.severity, '',\n  'Aircraft ID: ' + d.aircraft_id,\n  'Component: ' + d.component,\n  'Report Date: ' + d.report_date,\n  'Technician: ' + d.technician,\n  'Location: ' + d.location,\n  'Observation: ' + d.observation, '',\n  'AI ANALYSIS', ''\n].concat(String(d.analysis).split('\\n'));\n\nconst lines = [];\nraw.forEach(l => {\n  let t = clean(l);\n  while (t.length > 85) {\n    let cut = t.lastIndexOf(' ', 85);\n    if (cut < 30) cut = 85;\n    lines.push(t.slice(0, cut));\n    t = t.slice(cut).trim();\n  }\n  lines.push(t);\n});\nlines.push('', 'Final decision remains with a human reviewer.');\n\nconst per = 48, pages = [];\nfor (let i = 0; i < lines.length; i += per) pages.push(lines.slice(i, i + per));\n\nconst objs = [];\nobjs[1] = '<< /Type /Catalog /Pages 2 0 R >>';\nobjs[2] = '<< /Type /Pages /Kids [' + pages.map((_, i) => (4 + i * 2) + ' 0 R').join(' ') + '] /Count ' + pages.length + ' >>';\nobjs[3] = '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>';\npages.forEach((pl, i) => {\n  const pn = 4 + i * 2, cn = 5 + i * 2;\n  let s = 'BT /F1 11 Tf 50 800 Td 15 TL\\n';\n  pl.forEach(l => { s += '(' + l + ') Tj T*\\n'; });\n  s += 'ET';\n  objs[pn] = '<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] /Contents ' + cn + ' 0 R /Resources << /Font << /F1 3 0 R >> >> >>';\n  objs[cn] = '<< /Length ' + s.length + ' >>\\nstream\\n' + s + '\\nendstream';\n});\n\nlet pdf = '%PDF-1.4\\n';\nconst offs = [];\nfor (let i = 1; i < objs.length; i++) {\n  offs[i] = pdf.length;\n  pdf += i + ' 0 obj\\n' + objs[i] + '\\nendobj\\n';\n}\nconst x = pdf.length;\npdf += 'xref\\n0 ' + objs.length + '\\n0000000000 65535 f \\n';\nfor (let i = 1; i < objs.length; i++) pdf += String(offs[i]).padStart(10, '0') + ' 00000 n \\n';\npdf += 'trailer\\n<< /Size ' + objs.length + ' /Root 1 0 R >>\\nstartxref\\n' + x + '\\n%%EOF';\n\nconst fileName = 'AeroGuard_' + (d.aircraft_id || 'report') + '.pdf';\nconst binary = await this.helpers.prepareBinaryData(Buffer.from(pdf, 'latin1'), fileName, 'application/pdf');\nreturn [{ json: d, binary: { data: binary } }];"
      },
